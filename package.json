{
  "private": true,
  "name": "root",
  "version": "0.0.0",
  "scripts": {
    "lint": "biome check --write && lerna exec -- tsc --noEmit",
    "test": "lerna exec -- npm test",
    "tauri:lattice": "TAURI_APP_PATH=$PWD/crates/lattice CARGO_TARGET_DIR=$PWD/target/lattice tauri",
    "tauri:shadow": "TAURI_APP_PATH=$PWD/crates/shadow CARGO_TARGET_DIR=$PWD/target/shadow tauri",
    "tauri:time": "TAURI_APP_PATH=$PWD/crates/time CARGO_TARGET_DIR=$PWD/target/time tauri",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.13.10",
    "husky": "^8.0.3",
    "lerna": "^8.2.4",
    "lint-staged": "^15.1.0",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.ts": "biome check --write"
  },
  "packageManager": "pnpm@10.33.2"
}
